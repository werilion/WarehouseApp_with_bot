<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WarehouseApp.ViewModels"
        xmlns:v="clr-namespace:WarehouseApp.Views"
        mc:Ignorable="d"
        Title="Складской учёт PRO" Height="850" Width="1250"
        WindowStartupLocation="CenterScreen" Background="White">

    <Window.Resources>
        <!-- 1. ЦВЕТОВАЯ ПАЛИТРА FIGMA -->
        <SolidColorBrush x:Key="SidebarBack" Color="#253D5B"/>
        <SolidColorBrush x:Key="HeaderBlue" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="HoverBlue" Color="#3E5A7E"/>

        <!-- 2. МАППИНГ: Какую страницу (View) рисовать для каждой ViewModel -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><v:ProductsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OperationsViewModel}"><v:OperationsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><v:InventoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}"><v:ChatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupportViewModel}"><v:SupportView/></DataTemplate>

        <!-- 3. СТИЛЬ КНОПОК МЕНЮ -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBlue}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/> <!-- Сайдбар -->
            <ColumnDefinition Width="*"/>   <!-- Контентная область -->
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ (SIDEBAR) -->
        <Border Background="{StaticResource SidebarBack}" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" Margin="25,30,20,40">
                    <Ellipse Width="22" Height="22" Fill="#D97E38" Margin="0,0,12,0"/>
                    <TextBlock Text="СКЛАДСКОЙ УЧЁТ" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="15"/>
                </StackPanel>

                <!-- Основное меню -->
                <StackPanel Grid.Row="1">
                    <Button Content="🏠  Главная" Command="{Binding ShowDashboardCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="📦  Товары" Command="{Binding ShowProductsCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="📥  Приход" Command="{Binding ShowIncomeCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="📤  Расход" Command="{Binding ShowOutcomeCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="📝  Инвентаризация" Command="{Binding ShowInventoryCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="📜  История операций" Command="{Binding ShowHistoryCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    
                    <Separator Margin="15,10" Background="#3E4F5F"/>
                    
                    <!-- Секция управления (Видна по ролям) -->
                    <Button Content="📊  Отчёты" 
                            Visibility="{Binding ManagerVisibility}" 
                            Command="{Binding ShowReportsCommand}" 
                            Style="{StaticResource MenuButtonStyle}"/>
                            
                    <Button Content="👥  Пользователи" 
                            Visibility="{Binding AdminVisibility}" 
                            Command="{Binding ShowUsersCommand}" 
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Content="⚙  Настройки" 
                            Visibility="{Binding AdminVisibility}" 
                            Command="{Binding ShowSettingsCommand}" 
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Separator Margin="15,10" Background="#3E4F5F"/>
                    <Button Content="🤖  Помощник" Command="{Binding ShowChatCommand}" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="🛟  Техподдержка" Command="{Binding ShowSupportCommand}" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <!-- Выход из приложения -->
                <Button Grid.Row="2" Content="🚪  Выйти из системы" 
                        Command="{Binding LogoutCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MenuButtonStyle}" Margin="0,0,0,20" Foreground="#FF8585"/>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ (HEADER + CONTENT) -->
        <Grid Grid.Column="1" Background="#F4F7F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/> <!-- Хедер -->
                <RowDefinition Height="*"/>  <!-- Основной экран -->
                <RowDefinition Height="30"/> <!-- Футер -->
            </Grid.RowDefinitions>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ (HEADER) -->
            <Border Background="{StaticResource HeaderBlue}" Grid.Row="0">
                <Grid Margin="25,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Добро пожаловать, " Foreground="White" FontSize="16"/>
                        <TextBlock Text="{Binding UserFullName}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- ГЛОБАЛЬНЫЙ КОНТЕКСТНЫЙ ПОИСК -->
                    <Border Background="White" CornerRadius="17" Height="34" Width="280" HorizontalAlignment="Right">
                        <Grid>
                            <!-- Подсказка-плейсхолдер -->
                            <TextBlock Text="🔍 Поиск..." 
                                       VerticalAlignment="Center" 
                                       Foreground="Gray" 
                                       Margin="15,0" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=HeaderSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Поле ввода текста поиска -->
                            <TextBox x:Name="HeaderSearchBox" 
                                     Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     VerticalContentAlignment="Center" 
                                     Margin="15,0,15,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ОБЛАСТЬ КОНТЕНТА (Динамическая смена страниц) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

            <!-- ФУТЕР (СТАТУСНАЯ СТРОКА) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0">
                    <TextBlock Text="База данных: подключена" Foreground="#5CB85C" FontSize="11" FontWeight="Medium"/>
                    <Separator Width="1" Margin="15,5" Background="#E0E0E0"/>
                    <TextBlock Text="{Binding UserRole}" Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>