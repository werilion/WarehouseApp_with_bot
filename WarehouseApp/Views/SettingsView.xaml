<UserControl x:Class="WarehouseApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F4F7F9"
             UseLayoutRounding="True">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: ДАННЫЕ ОРГАНИЗАЦИИ -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Настройки организации" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E0E6ED" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.03" ShadowDepth="2"/>
                </Border.Effect>
                
                <StackPanel>
                    <TextBlock Text="Название склада" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding WarehouseName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,0,20"/>

                    <TextBlock Text="Юридический адрес" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding WarehouseAddress, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,0,30"/>

                    <Button Content="СОХРАНИТЬ ИЗМЕНЕНИЯ" 
                            Command="{Binding SaveGeneralSettingsCommand}" 
                            Height="45" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: СПРАВОЧНИК КАТЕГОРИЙ -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Справочник категорий" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,25"/>

            <!-- Форма добавления -->
            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderBrush="#E0E6ED" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="38" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="+ Добавить" 
                            Command="{Binding AddCategoryCommand}" 
                            Padding="20,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Список категорий -->
            <Border Background="White" CornerRadius="12" Padding="10" BorderBrush="#E0E6ED" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" 
                          BorderThickness="0" Background="Transparent" 
                          MaxHeight="450" RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Padding" Value="10,0,0,10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F2F6"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="НАИМЕНОВАНИЕ" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" 
                                            Background="Transparent" BorderThickness="0" Foreground="#D9534F" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>