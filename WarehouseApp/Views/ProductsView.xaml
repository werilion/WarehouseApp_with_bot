<UserControl x:Class="WarehouseApp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F9">
    <Grid Margin="25">
        
        <!-- 1. СЛОЙ СПИСКА ТОВАРОВ -->
        <Grid Visibility="{Binding ListVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Справочник товаров" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>
                <Button Content="+ Добавить товар" Command="{Binding SwitchToAddCommand}" 
                        Padding="15,8" Background="#5B9BD5" Foreground="White" BorderThickness="0" FontWeight="Bold">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="1"/></Border.Effect>
                <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#D9534F" FontSize="16"
                                            Visibility="{Binding DataContext.DeleteVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 2. СЛОЙ ФОРМЫ ДОБАВЛЕНИЯ (Появляется на том же месте) -->
        <Border Visibility="{Binding FormVisibility}" Background="White" CornerRadius="12" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="30">
            <Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="5"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="Новый товар" FontSize="22" FontWeight="Bold" Margin="0,0,0,25"/>

                <TextBlock Text="Наименование:" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewName}" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Категория:" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Height="35" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Цена:" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewPrice}" Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Ед. изм:" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewUnit}" Height="35"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Command="{Binding CancelAddCommand}" Background="Transparent" Foreground="Gray" Margin="0,0,20,0" BorderThickness="0"/>
                    <Button Content="СОХРАНИТЬ" Command="{Binding SaveProductCommand}" Background="#27AE60" Foreground="White" Padding="25,10" FontWeight="Bold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>