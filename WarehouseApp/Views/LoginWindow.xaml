<Window x:Class="WarehouseApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WarehouseApp.ViewModels"
        Title="Авторизация" Height="350" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid Background="#F5F6FA">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="ВХОД В СИСТЕМУ" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <TextBlock Text="Логин:"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>
            
            <TextBlock Text="Пароль:"/>
            
            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
            
            <Button Content="Войти" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="35" Background="#2C3E50" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>