<UserControl x:Class="WarehouseApp.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Инвентаризация и сверка остатков" FontSize="18" FontWeight="SemiBold" Margin="5,0,0,15" Foreground="#2C3E50"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E6ED" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.03" ShadowDepth="1"/>
            </Border.Effect>
            
            <DataGrid ItemsSource="{Binding Products}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      BorderThickness="0" 
                      Background="Transparent" 
                      RowHeight="32" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F2F6">
                
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                    
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="НАИМЕНОВАНИЕ ТОВАРА" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    
                    <DataGridTextColumn Header="ФАКТИЧЕСКИЙ ОСТАТОК" 
                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:N2}}" 
                                        Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="Foreground" Value="#2563EB"/> 
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="ЕД. ИЗМ." Binding="{Binding Unit}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="* Нажмите на число в колонке остатка, чтобы изменить его" 
                       Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" FontStyle="Italic"/>
            
            <Button Content="Сохранить изменения" 
                    Command="{Binding SaveChangesCommand}" 
                    HorizontalAlignment="Right"
                    Padding="20,8" 
                    Background="#10B981" 
                    Foreground="White" 
                    FontWeight="SemiBold" 
                    FontSize="13"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>